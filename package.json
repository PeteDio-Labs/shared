{
  "name": "@petedio/shared",
  "version": "0.2.0",
  "description": "Shared types and HTTP utilities for PeteDio Labs services",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types/index.ts",
    "./http": "./src/http/index.ts",
    "./sse": "./src/sse/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --strict",
    "prepublish": "bun run typecheck",
    "publish": "bun publish"
  },
  "publishConfig": {
    "registry": "https://registry.toastedbytes.com/repository/npm-private/"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
